{
  "name": "itinerisltd/acorn-favicons",
  "type": "package",
  "description": "Acorn package to generate favicons.",
  "license": "MIT",
  "authors": [
    {
      "name": "Itineris Limited",
      "email": "dev@itineris.co.uk",
      "homepage": "https://itineris.co.uk",
      "role": "Company"
    },
    {
      "name": "Dan Lapteacru",
      "email": "danlapteacru@gmail.com",
      "role": "Developer"
    },
    {
      "name": "Lee Hanbury-Pickett",
      "email": "lee.hanbury@gmail.com",
      "role": "Developer"
    }
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "roots/wordpress-core-installer": true
    }
  },
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "itinerisltd/itineris-wp-coding-standards": "^1.0",
    "roots/wordpress": "^6.8",
    "roots/acorn": "^4.3"
  },
  "conflict": {
    "roots/acorn": ">=5.0"
  },
  "autoload": {
    "psr-4": {
      "ItinerisLtd\\AcornFavicons\\": "src/"
    }
  },
  "extra": {
    "acorn": {
      "providers": [
        "ItinerisLtd\\AcornFavicons\\Providers\\AcornFaviconsServiceProvider"
      ],
      "aliases": {
        "AcornFavicons": "ItinerisLtd\\AcornFavicons\\Facades\\AcornFavicons"
      }
    }
  },
  "scripts": {
    "style:check": "phpcs",
    "style:fix": "phpcbf"
  }
}
